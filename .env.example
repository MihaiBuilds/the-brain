# The Brain — environment configuration
# Copy to .env and adjust. The .env file is gitignored.

# Database
# DB_PORT is the host port — 5433 by default so it does not clash with a
# Postgres already running on the host's 5432. It sets both the CLI's
# connection port and the docker compose host-side port mapping.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=the_brain
DB_USER=the_brain
DB_PASSWORD=the_brain

# Memory Vault — The Brain calls it over its REST API.
# When running via docker compose, use host.docker.internal to reach a
# Memory Vault instance on the host. Leave the token empty if that
# instance has API auth disabled.
MEMORY_VAULT_URL=http://localhost:8000
MEMORY_VAULT_TOKEN=

# Local LLM — OpenAI-compatible endpoint (LM Studio).
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=

# Logging — DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
